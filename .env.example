APP_NAME=umbrellax-wallets
APP_ENV=production
APP_PORT=9900
APP_NOTIFICATOR_PORT=9980

# POSTGRESQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ux_wallets
DB_USERNAME=ux_wallets
DB_PASSWORD=""

# REDIS
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=""
