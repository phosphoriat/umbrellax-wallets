APP_NAME=umbrellax-wallets
APP_ENV=production
APP_URL=127.0.0.1
APP_PORT=9900

# PGSQL
PGSQL_HOST=127.0.0.1
PGSQL_PORT=5432
PGSQL_DATABASE=ux_wallets
PGSQL_USERNAME=ux_wallets
PGSQL_PASSWORD=""

# CLICKHOUSE
CH_HOST=127.0.0.1
CH_PORT=8123
CH_DATABASE=ux_wallets
CH_USERNAME=ux_wallets
CH_PASSWORD=""

# REDIS
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=2
REDIS_BYBIT_REQUESTS_KEY=bybit_requests
REDIS_BYBIT_WITHDRAWALS_KEY=bybit_withdrawals
REDIS_REFILLS_KEY=refills
REDIS_WITHDRAWALS_KEY=withdrawals

# NATS
NATS_HOST=127.0.0.1
NATS_PORT=4222
NATS_USERNAME=wallets
NATS_PASSWORD=""
NATS_QUEUE=notifications

# VAULT
VAULT_HOST=127.0.0.1
VAULT_PORT=8200
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# BYBIT
BYBIT_API_URL=https://api.bybit.com
BYBIT_WS_URL=wss://stream.bybit.com/v5/private
BYBIT_API_KEY=
BYBIT_API_SECRET=

# AML
AML_API_URL=https://kyt-api.bitok.org/v1
AML_API_KEY=
AML_API_SECRET=
AML_CHECK_COST=1.1

# CHAIN RPC URLS
TRON_RPC_URL=https://tron-mainnet.gateway.tatum.io/
ETH_RPC_URL=https://ethereum-mainnet.gateway.tatum.io/
